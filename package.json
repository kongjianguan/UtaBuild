{
  "name": "utabuild-frontend",
  "private": true,
  "version": "1.2.0",
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "prebuild": "bash scripts/check-env.sh",
    "build:ts": "tsc",
    "build:scss": "sass src/scss/main.scss src/css/style.css --style compressed",
    "build": "pnpm run build:ts && pnpm run build:scss",
    "watch:ts": "tsc --watch",
    "watch:scss": "sass src/scss/main.scss src/css/style.css --watch",
    "lint": "eslint src/ts/ --ext .ts",
    "format": "prettier --write \"src/ts/**/*.ts\" \"src/scss/**/*.scss\""
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "sass": "^1.77.0",
    "eslint": "^8.57.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "prettier": "^3.3.0"
  }
}
