{
  "name": "utabuild-frontend",
  "private": true,
  "version": "1.2.1",
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "video:prepare": "node tools/teaching-video/prepare.mjs",
    "video:calibrate": "node tools/teaching-video/python.mjs calibrate",
    "video:render": "node tools/teaching-video/python.mjs render",
    "video:verify": "node tools/teaching-video/python.mjs verify",
    "video:edit": "node tools/teaching-video/python.mjs editor",
    "video:editor-e2e": "node tools/teaching-video/editor-e2e.mjs",
    "prebuild": "bash scripts/check-env.sh",
    "build:ts": "tsc",
    "build:scss": "sass src/scss/main.scss src/css/style.css --style compressed",
    "build": "pnpm run build:ts && pnpm run build:scss",
    "watch:ts": "tsc --watch",
    "watch:scss": "sass src/scss/main.scss src/css/style.css --watch",
    "lint": "eslint src/ts/ --ext .ts",
    "format": "prettier --write \"src/ts/**/*.ts\" \"src/scss/**/*.scss\""
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "prettier": "^3.3.0",
    "playwright": "1.62.1",
    "sass": "^1.77.0",
    "typescript": "^5.5.0"
  },
  "dependencies": {
    "@applemusic-like-lyrics/lyric": "1.1.0",
    "fast-xml-parser": "5.11.2",
    "opencc-js": "1.4.2"
  }
}
