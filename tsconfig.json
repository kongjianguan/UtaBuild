{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "rootDir": "src/ts",
    "outDir": "src/js",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "sourceMap": true,
    "declaration": false,
    "lib": ["ES2022", "DOM", "DOM.Iterable"]
  },
  "include": ["src/ts/**/*.ts"]
}
